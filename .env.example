# ======================================================================
#  MyHomeLab — secretos. Copia a .env  (nunca lo subas a GitHub)
#  Genera valores aleatorios con:  ./scripts/gen-secrets.sh
# ======================================================================

# --- Telegram -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABC...
# Solo estos IDs pueden usar el bot (separados por coma). El primero es el dueño.
TELEGRAM_ALLOWED_IDS=111111111
# Tu servidor Bot API local (en la Raspberry). Así suben y bajan archivos de hasta 2 GB.
# Si el servidor corre en la misma Pi, desde el contenedor es host.docker.internal
TELEGRAM_API_URL=http://host.docker.internal:8081
# Carpeta de datos del servidor Bot API (en modo --local). Se monta en el bot con la
# misma ruta para poder leer los archivos que le mandas desde el teléfono.
TELEGRAM_API_DATA=/var/lib/telegram-bot-api

# --- Web ----------------------------------------------------------------
# Nombre o IP con el que entras a la web (https://ESTO). Caddy crea un certificado local.
HOMELAB_HOST=192.168.1.5
# Puertos de la web. Si nginx ya usa 80/443 en la Pi: HTTP_PORT=8088 y HTTPS_PORT=8443 (el 8080 ya lo usa el bot)
HTTP_PORT=80
HTTPS_PORT=443
WEB_USER=admin
# Hash bcrypt de tu contraseña:  docker run --rm caddy caddy hash-password -p 'tu-clave'
# (en .env los $ se escriben dobles: $$2a$$14$$...)
WEB_PASSWORD_HASH=

# Token interno entre netwatch y el bot (gen-secrets.sh lo crea)
INTERNAL_TOKEN=cambia-esto

# Interfaz que escucha Suricata (perfil ids): eth0, o br0 en modo puente
CAPTURE_INTERFACE=eth0
# Dónde guarda la Pi los respaldos (idealmente un disco USB montado)
BACKUPS_DIR=/mnt/respaldos

# --- Servicios opcionales (perfiles) ------------------------------------
# Qué perfiles se encienden con «docker compose up -d» (o desde Ajustes): dns,servicios,ids
COMPOSE_PROFILES=
# AdGuard: el usuario/contraseña que creaste en su asistente (http://IP:3002)
ADGUARD_USER=
ADGUARD_PASSWORD=
# Vaultwarden: token de /vault/admin (gen-secrets.sh lo crea). Después de crear
# tu cuenta pon VW_SIGNUPS_ALLOWED=false para que nadie más se registre.
VW_ADMIN_TOKEN=
VW_SIGNUPS_ALLOWED=true
VW_DATA=/mnt/respaldos/vaultwarden

# --- Grafana ------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=cambia-esto

# --- Respaldos: un token por dispositivo de config/homelab.yml ----------
BACKUP_TOKEN_LAPTOP_LINUX=
BACKUP_TOKEN_LAPTOP_WIN=
BACKUP_TOKEN_MACBOOK=
BACKUP_TOKEN_TELEFONO=

# --- Redes sociales (Meta Graph API) -------------------------------------
# Token de página de larga duración con permisos pages_manage_posts,
# instagram_basic, instagram_content_publish (ver docs/redes-sociales.md)
META_PAGE_TOKEN=

# --- Cámaras (Frigate, en la PC) ----------------------------------------
# Usuario/clave de «Cuenta de cámara» creada en la app Tapo (Ajustes avanzados)
FRIGATE_RTSP_USER=
FRIGATE_RTSP_PASSWORD=

# --- VPS ----------------------------------------------------------------
# IP del VPS DENTRO de tu túnel WireGuard (la ves con: sudo wg show). node-exporter
# del VPS escucha solo ahí. Ponla también en infrastructure.nodes de homelab.yml.
VPN_VPS_IP=10.8.0.1

# --- VPN wg-easy (opcional, perfil «wg-easy») ----------------------------
WG_HOST=vps.tudominio.com
# Hash bcrypt para la web de wg-easy (mismo método que WEB_PASSWORD_HASH)
WG_PASSWORD_HASH=
