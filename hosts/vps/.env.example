# ======================================================================
#  .env del VPS — cópialo a hosts/vps/.env (solo lo que usa el VPS)
#    cp hosts/vps/.env.example hosts/vps/.env && nano hosts/vps/.env
#    docker compose -f hosts/vps/docker-compose.yml --env-file hosts/vps/.env up -d
# ======================================================================

# IP del VPS DENTRO de tu túnel WireGuard actual. La ves en el VPS con:
#   sudo wg show        (o: ip -4 addr show <interfaz del túnel>)
# node-exporter escuchará SOLO ahí: nadie en internet ve tus métricas.
VPN_VPS_IP=10.66.0.1

# --- Solo si levantas la VPN nueva con --profile wg-easy -----------------
# (NO lo hagas si tu túnel actual ya usa el puerto 51820)
WG_HOST=
WG_PASSWORD_HASH=
