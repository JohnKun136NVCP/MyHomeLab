# .env de la PC Linux del homelab (lo llena ./scripts/install-server.sh)
HOMELAB_PI=192.168.1.5
HOMELAB_PI_PORT=8443
SERVER_IP=
SERVER_GPU=cpu
TZ=America/Mexico_City
MEDIA_DIR=/srv/media
FRIGATE_MEDIA=/srv/frigate
# Cámaras Tapo (cuenta de cámara) — Frigate las usa como {FRIGATE_RTSP_USER}/{FRIGATE_RTSP_PASSWORD}
FRIGATE_RTSP_USER=admin
FRIGATE_RTSP_PASSWORD=
# Una por cada cámara genérica: FRIGATE_<NOMBRE>_PASSWORD (te lo dice el dashboard → Cámaras)
# FRIGATE_FOCO_SALA_PASSWORD=
# Respaldo semanal de esta PC al bot del homelab
BACKUP_DEVICE=pc-server
BACKUP_TOKEN=
HOMELAB_BACKUP_PASSWORD=
