# Entrada única al homelab:  https://{$HOMELAB_HOST}
# Certificado local de Caddy (la primera vez el navegador avisa; puedes instalar
# la CA de Caddy en tus equipos: ver docs/seguridad.md; se descarga en /ca.crt).
{
	admin off
	# Al entrar por IP el navegador no manda SNI; sin esto Caddy (dentro de Docker)
	# no sabe qué certificado usar y el navegador marca ERR_SSL_PROTOCOL_ERROR.
	default_sni {$HOMELAB_HOST}
}

# Inicio de sesión único (Authelia, opcional): ./scripts/sso.sh crea sso/sso.caddy
# con panel.casa.lan, auth.casa.lan… Sin ese archivo no se importa nada.
import /etc/caddy/sso/*.caddy

https://{$HOMELAB_HOST}:443 {
	tls internal
	encode zstd gzip

	# Los clientes de respaldo usan su propio token, no la contraseña web
	handle /api/backup/* {
		request_body {
			max_size 4GB
		}
		reverse_proxy bot:8080 {
			transport http {
				read_timeout 2h
				write_timeout 2h
			}
		}
	}

	# Panel de administración de Vaultwarden (invitar a la familia): además de su
	# token, solo para administradores del dashboard
	handle /vault/admin* {
		forward_auth host.docker.internal:8000 {
			uri /auth/check
			copy_headers X-Homelab-User X-Homelab-Role
		}
		reverse_proxy vaultwarden:80
	}

	# Vaultwarden tiene su propio inicio de sesión (y las apps de Bitwarden no
	# saben responder a la contraseña de Caddy), así que va sin basic_auth.
	handle /vault* {
		reverse_proxy vaultwarden:80
	}

	handle /grafana* {
		# Esta cabecera solo la pone el inicio de sesión único; por IP nadie puede mandarla
		request_header -X-Webauth-User
		reverse_proxy grafana:3000
	}

	# Solo para el bot (dentro de la Pi); desde fuera no existe
	handle /internal/* {
		respond 404
	}

	# Instaladores de «Mis respaldos» (enlace secreto que caduca en 7 días)
	handle /setup/* {
		reverse_proxy host.docker.internal:8000
	}

	# Inicio de sesión del panel (página propia, con «Cerrar sesión»)
	@public path /login /auth/login /auth/logout /static/* /ca.crt
	handle @public {
		reverse_proxy host.docker.internal:8000
	}

	handle {
		# Antes de cada página Caddy pregunta a netwatch si la cookie de sesión es válida
		forward_auth host.docker.internal:8000 {
			uri /auth/check
			copy_headers X-Homelab-User X-Homelab-Role
		}
		handle /prometheus* {
			reverse_proxy prometheus:9090
		}
		reverse_proxy host.docker.internal:8000
	}
}

# Acceso por http: redirige a https
http://{$HOMELAB_HOST} {
	redir https://{host}:{$HTTPS_PORT}{uri} permanent
}
