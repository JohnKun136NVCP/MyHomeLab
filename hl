#!/usr/bin/env bash
# ======================================================================
#  hl — atajo para manejar el homelab de la Pi sin recordar comandos largos.
#  Siempre usa hosts/pi/docker-compose.yml y --env-file .env (sin avisos WARN).
#
#    ./hl                        MENÚ con todas las herramientas (en una terminal)
#    ./hl menu [section]         el menú directo: status services photos backups security ups lab devices
#    ./hl help                   esta lista
#    ./hl status                 contenedores y si están sanos
#    ./hl update                 git pull + reconstruir + levantar
#    ./hl update --all           además: imágenes nuevas (Pi, casa, Immich), limpieza y escaneo Trivy
#    ./hl scan                   ¿qué imágenes tienen vulnerabilidades con arreglo? (Trivy)
#    ./hl roam [add SSID|now]    que la Pi visite tus otros SSID por turnos (y revisar por qué no)
#    sudo ./hl honeypot [status|test|remove]   trampa en la red: avisa si alguien toca servicios falsos
#    ./hl restart [svc...]       reinicia todo o los servicios indicados
#    ./hl logs [svc]             bitácora en vivo (Ctrl+C para salir)
#    ./hl check                  diagnóstico completo
#    ./hl services [enable|disable NAME]   opcionales: dns servicios ids speedtest diun botapi
#    ./hl photos [status|diagnose|open-firewall|update|install]   Immich
#    ./hl home [enable|disable NAME]   casa: homeassistant paperless navidrome mealie jellyseerr syncthing umami…
#    ./hl roles [ping|check|apply]     reparte servicios entre la Pi y tus PCs (Ansible)
#    ./hl link add|remove …      botón en el panel
#    ./hl firewall [--key-only]  aplica las reglas de UFW
#    ./hl backup                 respaldo cifrado del homelab ahora
#    ./hl restore FILE           restaura un respaldo del homelab
#    ./hl test-backup [--install]  descifra el último respaldo y revisa que sirve
#    ./hl ca                     copia el certificado de Caddy para instalarlo
#    ./hl password               cambia la contraseña del usuario admin de la web
#    ./hl passwords [reset SERVICIO [USUARIO]]  restablecer Grafana, AdGuard, Home Assistant, Paperless…
#    ./hl secrets                genera las llaves que falten en .env
#    ./hl speedtest-login        usuario y contraseña de Speedtest (y cómo cambiarla)
#    ./hl export-logs [7d]       bitácoras de todos los servicios en un .tar.gz (para revisar o pedir ayuda)
#    ./hl vps [IP:9100]          ¿por qué Prometheus ve el VPS abajo? (y lo agrega/corrige)
#    ./hl vps --mute|--unmute    apagar / prender los avisos de «VPS caído»
#    ./hl ups                    no-break por USB: avisos y apagado en orden (NUT)
#    ./hl sso [--remove]         inicio de sesión único con Authelia (panel.casa.lan)
#    ./hl crowdsec [status|unban IP|remove]  bloquea IPs que atacan SSH o el panel (CrowdSec)
#    ./hl bots [add|list|restart|logs|cli|remove]  tus otros bots de Telegram (ej. yt-telegrambot)
#    ./hl migrate                pasa todo a la PC (desde cero o copiando de esta Pi)
#    ./hl clean [--plan]         deja la Pi limpia (quita todo lo del homelab)
#    ./hl <otra cosa>            se pasa tal cual a «docker compose» (ps, exec, pull…)
#  (Los nombres de antes en español —estado, actualizar, respaldo…— siguen funcionando.)
# ======================================================================
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
cd "$REPO"
if docker info >/dev/null 2>&1; then D=(docker); else D=(sudo docker); fi
C=("${D[@]}" compose -f hosts/pi/docker-compose.yml --env-file .env)

perfiles() { grep -E '^COMPOSE_PROFILES=' .env | tail -1 | cut -d= -f2- | tr -d "\"' "; }

if [[ $# -eq 0 && -t 0 && -t 1 ]]; then exec ./scripts/menu.sh; fi
cmd="${1:-help}"; shift || true
if [[ ! -f .env && ! "$cmd" =~ ^(ayuda|help|-h|--help|secrets|secretos|home|casa|roles)$ ]]; then
  echo "Falta .env: corre ./scripts/gen-secrets.sh"; exit 1
fi
case "$cmd" in
  help|ayuda|-h|--help)
    sed -n '3,35p' "$0" | sed 's/^# \{0,3\}//' ;;
  status|estado)
    "${C[@]}" ps --format 'table {{.Service}}\t{{.Status}}\t{{.Ports}}' ;;
  update|actualizar)
    [[ "${1:-}" == --all || "${1:-}" == --todo ]] && { shift; exec ./scripts/update-all.sh "$@"; }
    owner="$(stat -c %U .)"
    if [[ "$(id -un)" == "$owner" ]]; then git pull --ff-only; else sudo -u "$owner" git pull --ff-only; fi
    "${C[@]}" up -d --build --remove-orphans
    echo "✅ Actualizado. Recarga el dashboard con Ctrl+Shift+R." ;;
  restart|reiniciar)
    "${C[@]}" restart "$@" ;;
  logs)
    "${C[@]}" logs -f --tail 100 "$@" ;;
  check|revisar)
    exec ./scripts/check.sh "$@" ;;
  firewall)
    exec ./scripts/firewall.sh "$@" ;;
  backup|respaldo)
    exec ./scripts/backup.sh "$@" ;;
  restore|restaurar)
    exec ./scripts/restore.sh "$@" ;;
  ca)
    mkdir -p run
    "${C[@]}" cp caddy:/data/caddy/pki/authorities/local/root.crt run/homelab-ca.crt
    chmod 644 run/homelab-ca.crt
    echo "✅ Certificado en run/homelab-ca.crt"
    echo "   También se descarga desde el dashboard: https://IP-de-la-Pi:PUERTO/ca.crt"
    echo "   Guía para instalarlo: docs/seguridad.md" ;;
  password|contraseña|contrasena)
    ./scripts/gen-secrets.sh --web-password
    "${C[@]}" restart netwatch >/dev/null && echo "✅ Listo, ya puedes entrar con la contraseña nueva." ;;
  menu) exec ./scripts/menu.sh "$@" ;;
  secrets|secretos) exec ./scripts/gen-secrets.sh "$@" ;;
  vps) exec ./scripts/vps-check.sh "$@" ;;
  speedtest-login)
    em="$(grep -E '^SPEEDTEST_ADMIN_EMAIL=' .env | cut -d= -f2-)"; pw="$(grep -E '^SPEEDTEST_ADMIN_PASSWORD=' .env | cut -d= -f2-)"
    echo "Speedtest: http://$(grep -E '^HOMELAB_HOST=' .env | cut -d= -f2-):8765"
    echo "  Si lo encendiste ANTES de esta versión, el usuario es el de fábrica:  admin@example.com / password"
    echo "  Si es nuevo:  ${em:-admin@example.com} / ${pw:-password}"
    echo "  Cámbialo en la web: tu avatar → Perfil. ¿No entras? Pon una nueva aquí:"
    echo "    sudo ./hl passwords reset speedtest   (o panel → Contraseñas)" ;;
  export-logs|exportar-logs)
    since="${1:-7d}"; t="$(mktemp -d)"; out="run/logs-$(date +%Y%m%d-%H%M).tar.gz"; mkdir -p run
    for s in $("${C[@]}" ps --services 2>/dev/null); do "${C[@]}" logs --no-color --since "$since" "$s" > "$t/$s.log" 2>&1 || true; done
    for f in hosts/server/immich/docker-compose.yml hosts/home/docker-compose.yml; do
      [[ -f $f ]] || continue
      ef=.env; [[ $f == hosts/server/immich/* ]] && ef=hosts/server/immich/.env; [[ $f == hosts/home/* ]] && ef=hosts/home/.env
      for s in $("${D[@]}" compose -f "$f" --env-file "$ef" ps --services 2>/dev/null); do
        "${D[@]}" compose -f "$f" --env-file "$ef" logs --no-color --since "$since" "$s" > "$t/$s.log" 2>&1 || true
      done
    done
    journalctl --since "-${since%d} days" -u 'homelab-*' -t homelab-ups --no-pager > "$t/systemd-homelab.log" 2>/dev/null || true
    ./scripts/check.sh > "$t/check.txt" 2>&1 || true
    # Quita secretos que a veces salen en las bitácoras
    sed -i -E 's/(token|password|passwd|secret|api_hash|bearer)([=: "]+)[^ "&]+/\1\2***/Ig' "$t"/*.log "$t"/*.txt 2>/dev/null || true
    tar -czf "$out" -C "$t" . && rm -rf "$t"
    echo "✅ $out ($(du -h "$out" | cut -f1)) — los últimos $since; contraseñas y tokens tapados con ***" ;;
  home|casa) exec ./scripts/home.sh "$@" ;;
  roles) exec ./scripts/roles.sh "$@" ;;
  link) exec python3 scripts/lib/links.py "$@" ;;
  photos|immich|fotos)
    a="${1:-status}"; shift || true
    case "$a" in
      install|instalar) exec ./scripts/immich.sh "$@" ;;
      diagnostico|diagnóstico) exec ./scripts/immich.sh --diagnose "$@" ;;
      estado) exec ./scripts/immich.sh --status "$@" ;; actualizar) exec ./scripts/immich.sh --update "$@" ;;
      abrir-firewall) exec ./scripts/immich.sh --open-firewall "$@" ;;
      -*) exec ./scripts/immich.sh "$a" "$@" ;;
      *) exec ./scripts/immich.sh "--$a" "$@" ;;
    esac ;;
  services|servicios|perfiles)
    if [[ $# -eq 0 ]]; then
      echo "Encendidos: $(perfiles | tr ',' ' ')"; echo "Opciones: dns servicios ids speedtest diun botapi"
      echo "Uso: ./hl services enable speedtest   ·   ./hl services disable diun   ·   ./hl menu services"
      exit 0
    fi
    acc="$1"; p="${2:?Falta el nombre (dns, servicios, ids, speedtest, diun, botapi)}"
    cur="$(perfiles | tr ',' '\n' | grep -vx "$p" | grep -v '^$' || true)"
    case "$acc" in enable|on|encender) cur="$(printf '%s\n%s' "$cur" "$p")" ;; disable|off|apagar) ;; *) echo "Usa enable o disable"; exit 2 ;; esac
    new="$(grep -v '^$' <<<"$cur" | paste -sd, -)"
    tmp="$(mktemp)"; V="$new" awk 'BEGIN{v=ENVIRON["V"]; d=0} /^COMPOSE_PROFILES=/ {if(!d) print "COMPOSE_PROFILES="v; d=1; next} {print} END{if(!d) print "COMPOSE_PROFILES="v}' .env > "$tmp"
    cat "$tmp" > .env; rm -f "$tmp"
    ./scripts/gen-secrets.sh >/dev/null 2>&1 || true
    echo "COMPOSE_PROFILES=$new"
    "${C[@]}" up -d --remove-orphans ;;
  test-backup|probar-respaldo) exec ./scripts/test-backup.sh "$@" ;;
  ups|nut|nobreak|no-break) exec ./scripts/ups.sh "$@" ;;
  sso|authelia) exec ./scripts/sso.sh "$@" ;;
  crowdsec|cs) exec ./scripts/crowdsec.sh "$@" ;;
  bots|bot) exec ./scripts/bots.sh "$@" ;;
  passwords|contraseñas|contrasenas) exec ./scripts/passwords.sh "$@" ;;
  scan|escanear) exec ./scripts/update-all.sh --scan-only ;;
  honeypot|trampa) exec ./scripts/honeypot.sh "$@" ;;
  roam|redes) exec ./scripts/roam.sh "$@" ;;
  migrate|migrar) exec ./scripts/migrate.sh "$@" ;;
  clean|limpiar) exec ./scripts/clean-pi.sh "$@" ;;
  *)
    "${C[@]}" "$cmd" "$@" ;;
esac
